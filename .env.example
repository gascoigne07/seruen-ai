# Owner/server configuration only. Never commit .env or share keys with visitors.
# Copy this file only when .env does not already exist.

SERUEN_PROVIDER=openai
OPENAI_API_KEY=
# Run make models after setting the key. Choose a model supporting Responses
# and structured outputs. No model ID is assumed or selected automatically.
OPENAI_MODEL=
# Optional for models that support it; leave empty for the model default.
# Lower effort can reduce response time for this bounded selection task.
OPENAI_REASONING_EFFORT=

# Set to 1 for local-only demo. Also possible: SERUEN_PROVIDER=local.
SERUEN_DEMO=0

# Optional alternative, enabled only with SERUEN_PROVIDER=gemini:
GOOGLE_API_KEY=
GEMINI_MODEL=
# List the optional Gemini models with make gemini-models.
# If SERUEN_PROVIDER is omitted: OpenAI key wins, then Google key, else local.
# The public UI has no login, provider/model selection, or credential fields.

# Interactive place search for extracted names/addresses (never bulk collection).
# Set to 0 to disable external geocoding. Local/demo mode does not call it.
SERUEN_GEOCODING=1
# Optional owner-operated Photon endpoint; otherwise the public demo is used.
# SERUEN_GEOCODER_URL=https://photon.komoot.io/api/
